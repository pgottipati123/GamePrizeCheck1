# Copy this file to api/.env and fill in real values there. api/.env is git-ignored.
NODE_ENV=development
PORT=3000

# Comma-separated origins allowed to call the API (the Vite dev server by default).
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_PER_MINUTE=120

# Supabase project (Project Settings > API).
SUPABASE_URL=
# Server-side only: the service role key bypasses Row Level Security. Never commit it or expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for the write endpoint (PATCH /api/listings/:id), sent as the X-Admin-Key header.
# Use any random string of 16+ characters, e.g. the output of: openssl rand -hex 24
ADMIN_API_KEY=
