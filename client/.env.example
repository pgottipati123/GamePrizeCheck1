# The client never talks to Supabase. It calls the Express API at /api, which
# Vite forwards to http://localhost:3000 in development (see vite.config.js).
# Optional: call the API at a different origin instead of using the proxy.
# VITE_API_BASE_URL=http://localhost:3000
# Optional: change where the Vite dev/preview proxy forwards /api.
# VITE_API_PROXY_TARGET=http://localhost:3000
